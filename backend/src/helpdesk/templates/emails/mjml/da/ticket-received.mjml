<mjml>
  <mj-head>
    <mj-title>[#{{ ticket_number }}] Vi har modtaget din henvendelse</mj-title>
    <mj-preview>Tak fordi du kontaktede {{ organization_name }}</mj-preview>
    <mj-include path="../../../../../platform/templates/emails/mjml/shared/_head.mjml" />
  </mj-head>
  <mj-body background-color="#eff1f5" width="600px">
    <mj-wrapper background-color="#ffffff" border="1px solid #e0e3eb" border-radius="12px" padding="0" css-class="app-card">
      <mj-include path="../../../../../platform/templates/emails/mjml/shared/_header.mjml" />

      <mj-section padding="28px 32px 32px 32px" css-class="app-pad">
        <mj-column>
          <mj-text font-size="13px" font-weight="600" color="#636b7e" text-transform="uppercase" letter-spacing="0.04em" padding="0 0 10px 0">
            {{ organization_name }} support
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#131825" line-height="1.3" padding="0 0 14px 0">
            Vi har modtaget din henvendelse
          </mj-text>

          <mj-text padding="0 0 8px 0">
            Tak fordi du kontaktede os. Din henvendelse #{{ ticket_number }} "{{ ticket_subject }}" er modtaget, og vi svarer så hurtigt, vi kan.
          </mj-text>

          <mj-button href="{{ conversation_url }}" align="left" padding="16px 0 0 0">
            Se din samtale
          </mj-button>

          <mj-text padding="20px 0 0 0" color="#636b7e" font-size="14px">
            Gem denne email: linket giver dig adgang til at følge samtalen og svare.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="../../../../../platform/templates/emails/mjml/da/partials/_footer.mjml" />
  </mj-body>
</mjml>
